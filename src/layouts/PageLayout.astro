---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { breadcrumbLd, graph, organizationLd, websiteLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  updated: string;
  schemaType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'ProfilePage';
  extraLd?: object[];
}
const { title, description, updated, schemaType = 'WebPage', extraLd = [] } = Astro.props;
const site = Astro.site!;
const crumbs = [
  { name: '홈', href: '/' },
  { name: title, href: Astro.url.pathname },
];
const [y, m, d] = updated.split('-').map(Number);
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={graph(
    {
      '@type': schemaType,
      name: title,
      description,
      url: new URL(Astro.url.pathname, site).href,
      inLanguage: 'ko-KR',
      dateModified: `${updated}T09:00:00+09:00`,
      isPartOf: { '@id': new URL('/#website', site).href },
    },
    breadcrumbLd(site, crumbs),
    websiteLd(site),
    organizationLd(site),
    ...extraLd,
  )}
>
  <div class="container">
    <div class="page-content">
      <Breadcrumb items={crumbs} />
      <h1>{title}</h1>
      <p class="updated">최종 업데이트: <time datetime={updated}>{y}년 {m}월 {d}일</time></p>
      <div class="prose">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
