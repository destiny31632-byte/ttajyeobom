---
interface Props {
  items: { name: string; href: string }[];
}
const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="현재 위치" data-pagefind-ignore>
  <ol>
    {
      items.map((it, i) =>
        i === items.length - 1 ? (
          <li aria-current="page">{it.name}</li>
        ) : (
          <li>
            <a href={it.href}>{it.name}</a>
          </li>
        ),
      )
    }
  </ol>
</nav>
