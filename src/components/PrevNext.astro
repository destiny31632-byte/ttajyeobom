---
import { postUrl, type Post } from '../lib/posts';

interface Props {
  prev?: Post;
  next?: Post;
}
const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="prev-next" aria-label="이전 글과 다음 글" data-pagefind-ignore>
      {prev ? (
        <a class="prev" href={postUrl(prev)} rel="prev">
          <small>← 이전 글</small>
          {prev.data.title}
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a class="next" href={postUrl(next)} rel="next">
          <small>다음 글 →</small>
          {next.data.title}
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
