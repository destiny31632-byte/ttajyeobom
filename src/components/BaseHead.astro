---
import '../styles/global.css';
import { ADS, ANALYTICS, SITE, VERIFICATION } from '../config/site';
import { adLoaderSrc } from '../lib/ads-markup.mjs';

export interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: object;
  article?: { published: string; modified: string; section: string; tags: string[] };
}

const { title, description, image = '/og-default.png', imageAlt, type = 'website', noindex = false, jsonLd, article } = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = title === SITE.name ? `${SITE.name} | ${SITE.tagline}` : `${title} | ${SITE.name}`;
const ogImage = new URL(image, site).href;
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1';
const adSrc = adLoaderSrc(ADS);
const ldJson = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content={SITE.themeColor} />
<meta name="generator" content={Astro.generator} />
<script is:inline>
  (function () {
    try {
      var t = localStorage.getItem('theme');
      var dark = t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    } catch (e) {}
  })();
</script>

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href={new URL('/rss.xml', site).href} />
<link rel="sitemap" type="application/xml" href={new URL('/sitemap.xml', site).href} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{
  article && (
    <>
      <meta property="article:published_time" content={article.published} />
      <meta property="article:modified_time" content={article.modified} />
      <meta property="article:section" content={article.section} />
      {article.tags.map((t) => <meta property="article:tag" content={t} />)}
    </>
  )
}

{VERIFICATION.google && <meta name="google-site-verification" content={VERIFICATION.google} />}
{VERIFICATION.naver && <meta name="naver-site-verification" content={VERIFICATION.naver} />}
{VERIFICATION.bing && <meta name="msvalidate.01" content={VERIFICATION.bing} />}

{ldJson && <script type="application/ld+json" is:inline set:html={ldJson} />}

{
  adSrc && (
    <>
      <meta name="google-adsense-account" content={ADS.client} />
      <script is:inline async src={adSrc} crossorigin="anonymous" />
    </>
  )
}

{
  ANALYTICS.ga4 && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS.ga4}`} />
      <script is:inline define:vars={{ id: ANALYTICS.ga4 }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', id);
      </script>
    </>
  )
}
{
  ANALYTICS.cfBeacon && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token: ANALYTICS.cfBeacon })}
    />
  )
}
