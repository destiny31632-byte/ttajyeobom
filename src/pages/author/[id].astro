---
import PageLayout from '../../layouts/PageLayout.astro';
import { AUTHORS, type Author } from '../../config/taxonomy';
import { SITE } from '../../config/site';
import { getPublishedPosts, postUrl } from '../../lib/posts';
import { personLd } from '../../lib/seo';
import { formatDateKo } from '../../lib/format';

export function getStaticPaths() {
  return Object.values(AUTHORS).map((author) => ({ params: { id: author.id }, props: { author } }));
}

interface Props {
  author: Author;
}
const { author } = Astro.props;
const posts = (await getPublishedPosts()).filter((p) => p.data.author === author.id && !p.data.draft);
---

<PageLayout
  title={`작성자 소개: ${author.name}`}
  description={`${SITE.name} ${author.name}의 역할, 작성 기준, 다루는 분야와 작성한 글 목록입니다.`}
  updated="2026-10-01"
  schemaType="ProfilePage"
  extraLd={[personLd(Astro.site!, author.id)]}
>
  <p><strong>{author.name}</strong> · {author.role}</p>
  {author.bio.map((p) => <p>{p}</p>)}

  <h2>주로 다루는 분야</h2>
  <ul>
    {author.focus.map((f) => <li>{f}</li>)}
  </ul>

  <h2>글을 쓸 때 지키는 기준</h2>
  <ul>
    <li>요금·가격·제도처럼 바뀌는 정보에는 기준일과 출처 조회일을 함께 적습니다.</li>
    <li>자료끼리 숫자가 다르면 한쪽으로 단정하지 않고 차이를 그대로 보여 줍니다.</li>
    <li>제목에 쓴 숫자와 주장은 본문에서 근거를 확인할 수 있어야 합니다.</li>
    <li>광고나 협찬이 글의 결론에 영향을 주지 않도록 합니다.</li>
  </ul>

  <h2>작성한 글 ({posts.length})</h2>
  {
    posts.length > 0 ? (
      <ul>
        {posts.map((p) => (
          <li>
            <a href={postUrl(p)}>{p.data.title}</a> <small>({formatDateKo(p.data.pubDate)})</small>
          </li>
        ))}
      </ul>
    ) : (
      <p>아직 발행된 글이 없습니다.</p>
    )
  }
  <p>오류 제보나 문의는 <a href="/contact/">문의 페이지</a>를 이용해 주세요.</p>
</PageLayout>
