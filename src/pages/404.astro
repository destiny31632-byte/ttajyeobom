---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES } from '../config/taxonomy';
import { getPublishedPosts, postUrl } from '../lib/posts';

const latest = (await getPublishedPosts()).slice(0, 5);
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청하신 주소의 페이지가 없거나 옮겨졌습니다." noindex={true}>
  <div class="container not-found">
    <p class="code">404</p>
    <h1>페이지를 찾을 수 없습니다</h1>
    <p>주소가 바뀌었거나 삭제된 페이지일 수 있습니다. 검색하거나 아래 목록에서 찾아보세요.</p>
    <form class="search-form" action="/search/" method="get" role="search" style="margin:20px auto">
      <label class="sr-only" for="nf-q">사이트 검색</label>
      <input id="nf-q" name="q" type="search" placeholder="찾으시는 내용을 입력하세요" />
      <button class="btn" type="submit">검색</button>
    </form>
    <p>
      {
        CATEGORIES.map((c, i) => (
          <>
            {i > 0 && ' · '}
            <a href={`/category/${c.slug}/`}>{c.name}</a>
          </>
        ))
      }
    </p>
    {
      latest.length > 0 && (
        <section style="max-width:560px;margin:32px auto 0;text-align:left">
          <h2 class="section-title">최신 글</h2>
          <ul class="compact-list">
            {latest.map((p) => (
              <li>
                <a href={postUrl(p)}>{p.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <p style="margin-top:32px"><a class="btn" href="/">홈으로 가기</a></p>
  </div>
</BaseLayout>
