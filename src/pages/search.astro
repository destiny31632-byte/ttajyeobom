---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE } from '../config/site';
---

<BaseLayout title="사이트 검색" description={`${SITE.name}에 실린 글을 검색합니다.`} noindex={true}>
  <div class="container page-section" style="max-width:var(--content)">
    <Breadcrumb
      items={[
        { name: '홈', href: '/' },
        { name: '검색', href: '/search/' },
      ]}
    />
    <h1 class="section-title" style="font-size:1.75rem;margin-top:14px">사이트 검색</h1>
    <form id="search-form" class="search-form" action="/search/" method="get" role="search">
      <label class="sr-only" for="q">검색어</label>
      <input id="q" name="q" type="search" placeholder="예: 전기장판 전기요금" autocomplete="off" />
      <button class="btn" type="submit">검색</button>
    </form>
    <p id="search-status" class="search-status" role="status" aria-live="polite">검색어를 입력하세요.</p>
    <ul id="search-results" class="search-results"></ul>
  </div>
</BaseLayout>

<script is:inline type="module">
  const form = document.getElementById('search-form');
  const input = document.getElementById('q');
  const status = document.getElementById('search-status');
  const list = document.getElementById('search-results');
  let pagefind = null;

  async function load() {
    if (!pagefind) {
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.options({ excerptLength: 28 });
      pagefind.init();
    }
    return pagefind;
  }

  async function run(q) {
    list.replaceChildren();
    if (!q.trim()) {
      status.textContent = '검색어를 입력하세요.';
      return;
    }
    status.textContent = '검색 중…';
    try {
      const pf = await load();
      const res = await pf.search(q);
      const items = await Promise.all(res.results.slice(0, 20).map((r) => r.data()));
      status.textContent = items.length
        ? `'${q}' 검색 결과 ${res.results.length}건`
        : `'${q}'에 대한 결과가 없습니다. 더 짧은 낱말이나 다른 표현으로 검색해 보세요.`;
      for (const it of items) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = it.url;
        a.textContent = (it.meta && it.meta.title) || it.url;
        const p = document.createElement('p');
        p.innerHTML = it.excerpt;
        li.append(a, p);
        list.append(li);
      }
    } catch (e) {
      status.textContent = '검색 색인을 불러오지 못했습니다. 잠시 후 다시 시도해 주세요.';
    }
  }

  const initial = new URLSearchParams(location.search).get('q') || '';
  if (initial) {
    input.value = initial;
    run(initial);
  }
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = input.value;
    const url = new URL(location.href);
    url.searchParams.set('q', q);
    history.replaceState(null, '', url);
    run(q);
  });
</script>
