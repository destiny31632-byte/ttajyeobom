---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostGrid from '../components/PostGrid.astro';
import { SITE } from '../config/site';
import { CATEGORIES } from '../config/taxonomy';
import { readBillPreview } from '../lib/bill-preview';
import { categoryUrl, getPopularPosts, getPublishedPosts, postUrl } from '../lib/posts';
import { graph, organizationLd, websiteLd } from '../lib/seo';

const posts = await getPublishedPosts();
const latest = posts.slice(0, 9);
const { posts: popular, basis } = await getPopularPosts(5);
const byCategory = CATEGORIES.map((c) => ({ ...c, posts: posts.filter((p) => p.data.category === c.slug) }));
const site = Astro.site!;

// 첫 화면 미리보기: 전기요금 글의 계산표를 그대로 읽어 옴 (글이 없거나 표가 바뀌어 못 읽으면 숨김)
const billPost = posts.find((p) => p.id === '2026-household-electricity-bill-calculation-guide');
const bill = billPost ? readBillPreview(billPost.body ?? '') : null;
const billMax = bill ? Math.max(...bill.rows.map((r) => r.amount)) : 0;
const billJump = bill ? Math.max(...bill.rows.map((r) => r.delta ?? 0)) : 0;
const won = (n: number) => n.toLocaleString('ko-KR');
---

<BaseLayout title={SITE.name} description={SITE.description} jsonLd={graph(websiteLd(site), organizationLd(site))}>
  <section class:list={['hero', { 'hero--split': bill }]}>
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>결정하기 전에, 숫자로 따져보세요</h1>
        <p>생활요금·공공서비스·가전·여행 비용을 공식 자료로 확인하고, 요금·비용·기간은 직접 계산한 표로 비교합니다</p>
        <form class="search-form" action="/search/" method="get" role="search">
          <label class="sr-only" for="home-q">사이트 검색</label>
          <input id="home-q" name="q" type="search" placeholder="예: 전기요금, 여권 재발급, 배터리 교체" autocomplete="off" />
          <button class="btn" type="submit">검색</button>
        </form>
      </div>

      {
        bill && billPost && (
          <figure class="calc-card">
            <figcaption>
              <span class="calc-card__label">직접 계산한 표 · 전기요금</span>
              <span class="calc-card__title">{bill.heading}</span>
            </figcaption>
            <table>
              <thead>
                <tr>
                  <th scope="col">월 사용량</th>
                  <th scope="col" class="calc-bar-col">
                    <span class="sr-only">비율</span>
                  </th>
                  <th scope="col">예상 청구액</th>
                  <th scope="col" class="calc-delta-col">앞 구간 대비</th>
                </tr>
              </thead>
              <tbody>
                {bill.rows.map((r) => (
                  <tr class:list={{ 'is-jump': r.delta === billJump }}>
                    <th scope="row">{r.usage}</th>
                    <td class="calc-bar-col" aria-hidden="true">
                      <span class="calc-bar" style={`--w:${((r.amount / billMax) * 100).toFixed(1)}%`} />
                    </td>
                    <td>{won(r.amount)}원</td>
                    <td class="calc-delta-col">{r.delta === null ? '—' : `+${won(r.delta)}`}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <div class="calc-card__foot">
              {bill.basis && <span>{bill.basis}</span>}
              <a href={postUrl(billPost)}>계산 과정 보기 →</a>
            </div>
          </figure>
        )
      }
    </div>
  </section>

  <div class="container">
    <section class="page-section" aria-labelledby="latest-title">
      <div class="section-head">
        <h2 id="latest-title" class="section-title">최신 글</h2>
        <a class="more-link" href="/posts/">전체 글 보기 →</a>
      </div>
      <PostGrid posts={latest} />
    </section>

    {
      popular.length > 0 && (
        <section class="page-section" aria-labelledby="popular-title">
          <h2 id="popular-title" class="section-title">
            {basis === 'search' ? '많이 읽은 글' : '먼저 읽어 볼 만한 글'}
          </h2>
          <ol class="compact-list ranked">
            {popular.map((p) => (
              <li>
                <a href={postUrl(p)}>{p.data.title}</a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <section class="page-section" aria-labelledby="cat-title">
      <h2 id="cat-title" class="section-title">카테고리별로 보기</h2>
      <div class="category-grid">
        {
          byCategory.map((c) => (
            <section class="category-card">
              <h3>
                <a href={categoryUrl(c.slug)}>{c.name}</a>
                <span class="count">{c.posts.length}편</span>
              </h3>
              <p>{c.description}</p>
              {c.posts.length > 0 ? (
                <ul class="compact-list">
                  {c.posts.slice(0, 3).map((p) => (
                    <li>
                      <a href={postUrl(p)}>{p.data.title}</a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="empty">아직 올라온 글이 없습니다</p>
              )}
            </section>
          ))
        }
      </div>
    </section>

    <section class="page-section" aria-labelledby="how-title">
      <h2 id="how-title" class="section-title">따져봄은 이렇게 만듭니다</h2>
      <div class="principles">
        <section>
          <h3>공식 자료가 먼저</h3>
          <p>정부·공공기관과 제조사 공식 문서를 1차 근거로 삼고, 보도는 교차 확인용으로 씁니다. 모든 글 끝에 출처와 조회일을 남깁니다.</p>
        </section>
        <section>
          <h3>직접 계산한 표</h3>
          <p>요금·비용·기간처럼 숫자가 필요한 내용은 계산 기준을 밝히고 표로 다시 계산합니다. 흩어진 정보를 결정 순서대로 묶습니다.</p>
        </section>
        <section>
          <h3>틀리면 고칩니다</h3>
          <p>
            정보가 바뀌거나 오류를 확인하면 본문을 고치고 수정일을 표시합니다. 기준은 <a href="/editorial-policy/">편집 원칙</a>에 공개해
            두었습니다.
          </p>
        </section>
      </div>
    </section>
  </div>
</BaseLayout>
