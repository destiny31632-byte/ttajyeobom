# ─────────────────────────────────────────────────────────────
# 따져봄 환경 변수 예시 (실제 값은 절대 커밋하지 마세요)
# 로컬: .env 파일 / GitHub Actions: Settings → Secrets and variables
# Vercel: Project → Settings → Environment Variables
# 모든 항목은 선택 사항입니다. 비어 있으면 해당 기능만 꺼집니다.
# ─────────────────────────────────────────────────────────────

# 사이트 주소 (기본값: src/config/site-url.mjs). 개인 도메인 연결 시 변경
SITE_URL=

# ── 사이트 공개 설정 (PUBLIC_ 접두사 = 브라우저에 노출되는 공개 값) ──
# 문의 이메일 (문의/개인정보처리방침 페이지에 표시)
PUBLIC_CONTACT_EMAIL=
# 애드센스 게시자 ID (예: ca-pub-0000000000000000)
#  ⚠ Vercel Hobby(무료)는 광고 게재가 약관상 금지 → Cloudflare 등으로 이전 후 설정
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_ARTICLE_TOP=
PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
PUBLIC_ADSENSE_SLOT_ARTICLE_BOTTOM=
PUBLIC_ADSENSE_SLOT_SIDEBAR=
# 검색엔진 소유 확인 메타 태그 값
PUBLIC_GSC_VERIFICATION=
PUBLIC_NAVER_VERIFICATION=
PUBLIC_BING_VERIFICATION=
# 무료 분석 도구 (둘 다 비우면 분석 스크립트 없음)
PUBLIC_GA4_ID=
PUBLIC_CF_BEACON_TOKEN=

# ── 자동화 파이프라인 (GitHub Actions Secrets 권장) ──
# true 일 때만 품질 검수를 통과한 글을 자동 발행. 기본 false = 초안만 생성
AUTO_PUBLISH=false
# true 면 AI 호출을 전부 차단 (비상 정지)
AI_DISABLED=true
# 공급자 프로젝트가 결제 계정과 연결되지 않은 Free tier임을 실제 확인한 뒤 설정.
# 이 확인값만으로 과금 차단이 보장되는 것은 아닙니다.
AI_BILLING_TIER=
GEMINI_MODEL=

# 무료 AI 제공자 (하나 이상 있으면 자동 글쓰기 가능, 카드 등록 없는 무료 플랜 권장)
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# 무료 데이터 소스 (선택)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
TAVILY_API_KEY=
YOUTUBE_API_KEY=

# Search Console / GA4 성과 데이터 (서비스 계정 JSON 전체를 한 줄로)
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=
GA4_PROPERTY_ID=
